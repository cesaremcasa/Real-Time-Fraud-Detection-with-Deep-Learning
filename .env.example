# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Configurações do Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS_RAW=transactions_raw
KAFKA_TOPIC_FRAUD_PREDICTIONS=fraud_predictions
# JSON object mapping producer IDs to long random HMAC secrets. Required for
# POST /api/v1/transaction; never commit a real secret.
FRAUD_PRODUCER_SECRETS_JSON={"local-producer":"replace-with-a-long-random-secret"}

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
